# ==============================================================================
# RaktSetu Environment Configuration Template
# ==============================================================================

# Server & Runtime
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/raktsetu?replicaSet=rs0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Authentication & Security
JWT_ACCESS_SECRET=replace_with_a_super_secure_random_access_token_secret_min_32_chars
JWT_REFRESH_SECRET=replace_with_a_super_secure_random_refresh_token_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_super_secure_cookie_secret_string

# Notification Provider: 'mock' | 'twilio' | 'whatsapp_cloud' | 'sms'
NOTIFICATION_PROVIDER=mock

# Twilio Credentials (WhatsApp Sandbox & SMS Fallback)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=

# Meta WhatsApp Business Cloud API
WHATSAPP_CLOUD_API_URL=https://graph.facebook.com/v20.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=raktsetu_webhook_verify_token
WHATSAPP_APP_SECRET=

# Public Base URL (for deep links generated in notifications)
APP_BASE_URL=http://localhost:5173

# Logging & Monitoring
LOG_LEVEL=info
SENTRY_DSN=

# Demo Mode (Accelerate wave timer to 30 seconds for quick testing/demo)
DEMO_MODE=false
FAST_FORWARD_WAVE_SECONDS=30
